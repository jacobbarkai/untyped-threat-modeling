# Copy to .env and fill in one block. Never commit the resulting .env: it holds a
# live API key. Add it to .gitignore before you do anything else.
#
# Two families are supported.
#
#   LLM_PROVIDER=anthropic   native SDK. Keeps adaptive thinking and effort, which
#                            this task benefits from, and native json_schema output.
#
#   LLM_PROVIDER=openai      the /v1/chat/completions protocol, which is what most
#                            other vendors speak. Base URL plus key plus model name
#                            covers all of them.
#
# Structured output is requested as json_schema, falls back to json_object, then to
# a plain prompt instruction. A provider supporting none of the three still works,
# with weaker guarantees on the shape of what comes back.


# --- Anthropic -------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_API_KEY=sk-ant-...

# --- OpenAI ----------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# --- DeepSeek --------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...

# --- xAI / Grok ------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4
# LLM_API_KEY=xai-...

# --- Mistral ---------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-large-latest
# LLM_API_KEY=...

# --- Groq ------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# --- OpenRouter (many models behind one key) -------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-opus-4.1
# LLM_API_KEY=sk-or-...

# --- Ollama, local, no key needed ------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3
# LLM_API_KEY=ollama

# --- vLLM, self hosted -----------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=/models/your-model
# LLM_API_KEY=none

# Note on image input: --image needs a model with vision. Text-only models will
# fail on that path and work fine for --iac and --code.
